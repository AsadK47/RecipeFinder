# Xcode build files
build/
DerivedData/
xcuserdata/
TestResults.xcresult/

# Test artifacts
test_output.log
build_output.log

# Xcode project files that shouldn't be committed
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# App packaging
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager (Package.resolved is committed: it locks dependency versions)
.build/
Packages/

# macOS system files
.DS_Store
._*

# IDEs
.vscode/
.idea/

# Temporary files
*.tmp
*~

# ==============================================
# SENSITIVE FILES - NEVER COMMIT THESE
# ==============================================

# Certificates and Signing
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
**/certificate*.pdf
**/Certificate*.pdf
**/certicate*.pdf
**/Certicate*.pdf

# API Keys and Secrets (App Store Connect keys, private keys, SSH keys)
*.p8
AuthKey_*
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
secrets.json
config/secrets.*
**/api_keys.*
**/secrets.*

# Personal Information
**/personal_info.*
**/bank_details.*
**/passport.*
**/identity.*

# Xcode project backups (created by tooling; never commit)
*.pbxproj.backup

# Claude Code personal overrides
.claude/settings.local.json

# Python
__pycache__/
